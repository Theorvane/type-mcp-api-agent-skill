{
  "name": "type-mcp-api-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic local structured-spec inspection CLI",
  "type": "module",
  "bin": {
    "type-mcp-api-cli": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "npm pack --dry-run",
    "verify:installed-bin": "node test/package-bin.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package && npm run verify:installed-bin"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^24.12.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
